{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Interview Guide",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "attributes"
 ],
 "properties": {
  "attributes": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "key",
     "name",
     "question",
     "areas"
    ],
    "properties": {
     "key": {
      "type": "string",
      "enum": [
       "PE",
       "CC",
       "LF",
       "MF"
      ]
     },
     "name": {
      "type": "string"
     },
     "question": {
      "type": "string"
     },
     "areas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "id",
        "name",
        "what",
        "must_have",
        "questions",
        "rubric"
       ],
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^(PE|CC|LF|MF)[0-9]{1,2}$"
        },
        "name": {
         "type": "string"
        },
        "what": {
         "type": "string"
        },
        "must_have": {
         "type": "boolean"
        },
        "questions": {
         "type": "array",
         "minItems": 3,
         "maxItems": 4,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "q",
           "probes"
          ],
          "properties": {
           "q": {
            "type": "string",
            "minLength": 10
           },
           "probes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
             "type": "string"
            }
           }
          }
         }
        },
        "rubric": {
         "type": "array",
         "minItems": 3,
         "maxItems": 4,
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "level",
           "text"
          ],
          "properties": {
           "level": {
            "type": "string",
            "enum": [
             "Limited",
             "Borderline",
             "Solid",
             "Outstanding",
             "Aligned",
             "To discuss",
             "Material risk"
            ]
           },
           "text": {
            "type": "string",
            "minLength": 20
           }
          }
         }
        },
        "framework_no": {
         "type": "integer",
         "minimum": 1,
         "maximum": 17
        },
        "selection": {
         "type": "string",
         "enum": [
          "core",
          "role-specific"
         ]
        },
        "why": {
         "type": "string"
        },
        "evidence": {
         "type": "string"
        }
       }
      }
     },
     "level": {
      "type": "string",
      "enum": [
       "N-1 executive",
       "C-level"
      ]
     }
    }
   }
  }
 }
}